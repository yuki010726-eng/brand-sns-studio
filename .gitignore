# OS
.DS_Store
Thumbs.db
desktop.ini

# 편집기
.vscode/
.idea/

# 빌드 도구를 쓰지 않지만, 나중에 붙일 경우를 대비
node_modules/
dist/

# 배포 (Vercel)
.vercel/

# 비밀값은 저장소에 두지 않는다.
# 배포본의 API 키는 Vercel 환경 변수에만 있다. 로컬 실행에서는 브라우저 localStorage 또는
# 아래 config.local.js 에만 있다.
.env
.env.*
*.key
secrets.json

# 로컬 설정 — API 키가 들어간다. 절대 커밋하지 말 것.
# 템플릿은 config.example.js 이고 그쪽은 커밋된다(빈 값이어야 한다).
config.local.js
