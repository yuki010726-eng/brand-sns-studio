{
  "manifest_version": 3,
  "name": "브랜드 SNS 스튜디오 · 네이버 채우기",
  "version": "1.0.0",
  "description": "브랜드 SNS 스튜디오에서 만든 블로그 글과 카드뉴스를 내 브라우저의 네이버 글쓰기 화면에 채워 넣습니다. 발행은 직접 누릅니다.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "unlimitedStorage", "debugger"],
  "host_permissions": ["https://blog.naver.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://brand-sns-studio.vercel.app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://blog.naver.com/*"],
      "js": ["hook-main.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://blog.naver.com/*"],
      "js": ["filler.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
